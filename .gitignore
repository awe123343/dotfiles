!.gitignore
*
**.*

# Track the portable Codex template and generator, not the local config.
!/.codex/
!/.codex/config.toml.template
!/.codex/apply-codex-config-template.sh
/.codex/config.toml

# Track Yazi configuration and dependencies; keep installed flavors local.
!/.config/
!/.config/yazi/
!/.config/yazi/yazi.toml
!/.config/yazi/theme.toml
!/.config/yazi/package.toml
/.config/yazi/flavors/
